# ============================================
# TsuniForge — Production Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# ============================================

# Frontend URL (your Vercel deployment URL)
FRONTEND_URL=https://tsuniforge.vercel.app

# PostgreSQL
DB_USERNAME=tsuniforge
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DB_DATABASE=tsuniforge

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# Domain (for SSL — optional, set after you have a domain)
# DOMAIN=api.tsuniforge.com
